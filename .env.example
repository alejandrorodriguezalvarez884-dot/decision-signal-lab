# Copy to .env (git-ignored) or export these in your shell. Never commit real values.

# Perplexity API key (https://console.perplexity.ai/project/keys). Model: pplx-decider-v1-27b.
PERPLEXITY_API_KEY=

# SEC requires a descriptive User-Agent with a contact email for EDGAR access.
# Example: "DecisionSignalLab research your.name@example.com"
SEC_USER_AGENT=

# Hard spending cap per command run, in USD. The client refuses to start a batch whose
# estimate exceeds it and stops if actual spend crosses it.
DECIDER_MAX_USD=1.00

# Ceiling on everything the project spends on the API over its whole life, in USD. Counts
# what earlier runs already paid (every response in data/cache/decision_cache.sqlite).
DECIDER_TOTAL_MAX_USD=10.00

# Release date of the pinned model (YYYY-MM-DD), from its model card on Hugging Face. Events
# after it are reported separately: the model cannot have seen their outcomes.
DECIDER_RELEASE_DATE=
