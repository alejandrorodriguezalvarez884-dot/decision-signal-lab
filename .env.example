# Copy to .env (git-ignored) or export these in your shell. Never commit real values.

# TypeSafe API key (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=

# SEC requires a descriptive User-Agent with a contact email for EDGAR access.
# Example: "JevSignalDecisor research your.name@example.com"
SEC_USER_AGENT=

# Pinned model version (do not use the moving alias jev-latest for research).
JEV_MODEL=jev-1.13.0

# Hard spending cap per command run, in USD. The client refuses to start a batch whose
# estimate exceeds it and stops if actual spend crosses it.
JEV_MAX_USD=1.00

# Release date of the pinned model (YYYY-MM-DD), from `uv run jevsignal models`. Events after it
# are reported separately: the model cannot have seen their outcomes.
JEV_RELEASE_DATE=
