---
// One series over time: a 2px line with a light wash, the last value labelled.
import { tip, yearGroups } from "../lib/radar";

interface Props {
	title: string;
	note?: string;
	points: { label: string; year: string; value: number; n?: number }[];
	max: number;
	ticks: { v: number; label: string }[];
	format: (v: number) => string;
	what: string; // what the value is, for the tooltip row
	height?: number;
	now?: { value: string; note?: string }; // the latest value, set large beside the title
	words?: boolean; // the axis is labelled with words, which need a wider gutter
}
const { title, note, points, max, ticks, format, what, height = 240, now, words = false } = Astro.props;

const x = (i: number) => ((i + 0.5) / points.length) * 100;
const yv = (v: number) => (1 - v / max) * 100;
const line = points.map((p, i) => `${x(i).toFixed(2)},${yv(p.value).toFixed(2)}`).join(" ");
const area = `${x(0).toFixed(2)},100 ${line} ${x(points.length - 1).toFixed(2)},100`;
const last = points[points.length - 1];
const years = yearGroups(points.map((p) => p.year));
---

<figure class:list={["radar", { "radar-words": words }]}>
	<figcaption class="radar-head">
		<div>
			<div class="radar-title">{title}</div>
			{note && <div class="radar-note">{note}</div>}
		</div>
		{
			now && (
				<div class="radar-now">
					<b>{now.value}</b>
					{now.note && <span>{now.note}</span>}
				</div>
			)
		}
	</figcaption>
	<div class="radar-plot trend-plot" style={`height: ${height}px`}>
		{
			ticks.map((t) => (
				<div class:list={["radar-gridline", { "is-axis": t.v === 0 }]} style={`top: ${yv(t.v)}%`}>
					<span>{t.label}</span>
				</div>
			))
		}
		<svg class="trend-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
			<polygon points={area} fill="var(--radar-line)" fill-opacity="0.1"></polygon>
			<polyline
				points={line}
				fill="none"
				stroke="var(--radar-line)"
				stroke-width="2"
				stroke-linejoin="round"
				stroke-linecap="round"
				vector-effect="non-scaling-stroke"></polyline>
		</svg>
		<div class="trend-dot" style={`left: ${x(points.length - 1)}%; top: ${yv(last.value)}%`}></div>
		<div class="radar-bands">
			{
				points.map((p, i) => (
					<div
						class="radar-band"
						data-tip={tip({
							title: p.n === undefined ? p.label : `${p.label} · ${p.n} releases`,
							rows: [[what, format(p.value), "#2962ff"]],
						})}
					>
						<i class="trend-mark" style={`top: ${yv(p.value)}%`} />
					</div>
				))
			}
		</div>
	</div>
	<div class="radar-years trend-years">
		{years.map((g) => <div style={`grid-column: span ${g.span}`}>{g.span > 1 ? g.year : ""}</div>)}
	</div>
	<details class="radar-table mt-3">
		<summary>Show as table</summary>
		<div class="overflow-x-auto">
			<table>
				<tbody>
					{
						points.map((p) => (
							<tr>
								<td>{p.label}</td>
								<td>{format(p.value)}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</details>
</figure>

<style>
	.trend-plot,
	.trend-years {
		margin-right: 8px;
	}
	.trend-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.trend-dot,
	.trend-mark {
		position: absolute;
		width: 12px;
		height: 12px;
		margin: -6px 0 0 -6px;
		border-radius: 50%;
		background: var(--radar-line);
		border: 2px solid var(--radar-surface);
	}
	/* The point under the pointer. */
	.trend-mark {
		left: 50%;
		display: none;
	}
	.radar-band:hover .trend-mark,
	.radar-band.is-active .trend-mark {
		display: block;
	}
</style>
