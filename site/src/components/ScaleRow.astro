---
// One reading on its scale: where this release sits and where the peers' median is.
interface Props {
	label: string;
	low: string;
	high: string;
	value: number;
	peer: number;
}
const { label, low, high, value, peer } = Astro.props;
---

<div class="scale-row">
	<div class="scale-label">{label}</div>
	<div class="scale-body">
		<div class="scale-track">
			<span class="scale-peer" style={`left: ${peer * 100}%`}></span>
			<span class="scale-dot" style={`left: ${value * 100}%`}></span>
		</div>
		<div class="scale-ends"><span>{low}</span><span>{high}</span></div>
	</div>
</div>

<style>
	.scale-row {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 0.75rem;
		align-items: start;
		padding: 0.6rem 0;
	}
	.scale-label {
		font-size: 0.875rem;
		color: var(--radar-ink-2);
	}
	.scale-track {
		position: relative;
		height: 2px;
		margin: 9px 6px 0;
		background: var(--radar-axis);
	}
	.scale-dot {
		position: absolute;
		top: 50%;
		width: 14px;
		height: 14px;
		margin: -7px 0 0 -7px;
		border-radius: 50%;
		background: var(--radar-line);
		border: 2px solid var(--radar-surface);
	}
	.scale-peer {
		position: absolute;
		top: 50%;
		width: 2px;
		height: 14px;
		margin: -7px 0 0 -1px;
		background: var(--radar-ink-2);
	}
	.scale-ends {
		display: flex;
		justify-content: space-between;
		margin-top: 8px;
		font-size: 11px;
		color: var(--radar-muted);
	}
</style>
