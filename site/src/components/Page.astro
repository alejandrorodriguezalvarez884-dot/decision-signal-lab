---
// Shell shared by every page: header with the navigation, the page body and the footer.
import Layout from "../layouts/Layout.astro";
import HubBar from "./HubBar.astro";
import RadarStyles from "./RadarStyles.astro";
import { AUTHOR_URL, REPO_URL, link } from "../lib/reading";

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;

const path = Astro.url.pathname;
const under = (...roots: string[]) => roots.some((r) => path.startsWith(link(r)));
const links = [
	{ href: link("/"), label: "Analyse a company", short: "Analyse", active: path === link("/") || under("/analyze/") },
	{ href: link("/trends/"), label: "Market trends", short: "Market trends", active: under("/trends/", "/company/") },
	{ href: link("/method/"), label: "Method", short: "Method", active: under("/method/") },
];
---

<Layout title={`${title} — Earnings Radar`} description={description}>
	<header class="sticky top-0 z-50 border-b border-line bg-page/95 backdrop-blur">
		<nav class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4 sm:gap-6">
			<a href={link("/")} class="flex flex-none items-center gap-2 whitespace-nowrap text-[15px] font-bold tracking-tight text-ink-strong">
				<span class="brand-mark" aria-hidden="true"></span><span class="hidden sm:inline">Earnings Radar</span>
			</a>
			<ul class="flex items-center gap-0.5 text-[13px] font-semibold sm:gap-1">
				{
					links.map((l) => (
						<li>
							<a
								href={l.href}
								aria-current={l.active ? "page" : undefined}
								class={`whitespace-nowrap rounded px-2.5 py-2 transition-colors hover:bg-raised hover:text-ink-strong sm:px-3 ${l.active ? "text-ink-strong" : "text-muted"}`}
							>
								<span class="sm:hidden">{l.short}</span>
								<span class="hidden sm:inline">{l.label}</span>
							</a>
						</li>
					))
				}
			</ul>
			<div class="ml-auto"><HubBar /></div>
		</nav>
	</header>
	<main class="radar mx-auto max-w-6xl px-4 pb-16 pt-6 sm:pt-8">
		<slot name="header" />
		<slot />
		<p class="mt-14 border-t border-line pt-5 text-xs leading-relaxed text-muted">
			A description of what company press releases say, produced by a decision model. It is not a forecast of
			anything and it is not investment advice. Source text: SEC EDGAR.{" "}
			<a href={link("/method/")} class="underline hover:text-ink-strong">How it works</a>.
		</p>
	</main>
	<footer class="border-t border-line bg-deep">
		<div class="mx-auto flex max-w-6xl flex-wrap justify-center gap-x-4 gap-y-1 px-4 py-8 text-xs text-muted">
			<a href={AUTHOR_URL} class="hover:text-ink">Built by Alejandro Rodríguez Álvarez</a>
			<a href={REPO_URL} class="hover:text-ink">Source and data on GitHub</a>
		</div>
	</footer>
	<RadarStyles />
</Layout>

<style>
	/* Two rings and a dot: the radar. */
	.brand-mark {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		border: 2px solid #f0f3fa;
		background: radial-gradient(circle, #2962ff 0 4px, transparent 4.5px);
	}
</style>
