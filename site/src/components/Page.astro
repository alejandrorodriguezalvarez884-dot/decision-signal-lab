---
// Shell shared by every page. Inside Market Hub the radar is a section of My Hub, the portal's
// private area: the portal's private navigation at the side (HubNav) and, above the page, the
// radar's own bar with its pages and its search. On its own site (earningsradar.app) there is no
// portal around it: the same bar carries the radar's name.
import Layout from "../layouts/Layout.astro";
import CompanySearch from "./CompanySearch.astro";
import HubNav from "./HubNav.astro";
import RadarStyles from "./RadarStyles.astro";
import { AUTHOR_URL, HUB_URL, REPO_URL, link } from "../lib/reading";

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;

const path = Astro.url.pathname;
const under = (...roots: string[]) => roots.some((r) => path.startsWith(link(r)));
const pages = [
	{ href: link("/"), label: "Analyse a company", active: path === link("/") || under("/analyze/") },
	{ href: link("/trends/"), label: "Market trends", active: under("/trends/", "/company/") },
	{ href: link("/method/"), label: "Method", active: under("/method/") },
];
const brand = "flex flex-none items-center gap-2.5 whitespace-nowrap text-[15px] font-semibold tracking-tight text-ink-strong";
---

<Layout title={`${title} — Earnings Radar`} description={description}>
	<div class="lg:flex">
		<HubNav part="side" class="hub-only" />
		<div class="min-w-0 flex-1">
			<HubNav part="top" class="hub-only" />
			<header class="top-0 z-40 border-b border-line bg-page/95 backdrop-blur sm:sticky">
				<div class="mx-auto flex h-14 max-w-[1240px] items-center gap-4 px-5 lg:gap-8 lg:px-8">
					<a href={link("/")} class:list={[brand, "hub-only"]}>Earnings Radar</a>
					<a href={link("/")} class:list={[brand, "standalone-only"]}>
						<svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
							<circle cx="10" cy="10" r="8"></circle><circle cx="10" cy="10" r="2.5" fill="currentColor" stroke="none"></circle>
						</svg>
						<span>Earnings Radar</span>
					</a>
					<nav class="hidden sm:block" aria-label="Earnings Radar">
						<ul class="flex items-center gap-5 text-sm">
							{pages.map((l) => (
								<li><a href={l.href} aria-current={l.active ? "page" : undefined}
									class:list={["border-b py-1 transition-colors hover:text-ink-strong", l.active ? "border-ink-strong text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a></li>
							))}
						</ul>
					</nav>
					<div class="ml-auto hidden w-full max-w-sm md:block"><CompanySearch compact id="header-search" /></div>
					<button id="search-toggle" type="button" class="ml-auto rounded-sm p-2 text-muted hover:text-ink-strong md:hidden" aria-label="Search" aria-expanded="false" aria-controls="mobile-search">
						<svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6"></circle><path d="m14 14 4 4" stroke-linecap="round"></path></svg>
					</button>
				</div>
				<div id="mobile-search" class="border-t border-line px-5 py-2 md:hidden" hidden><CompanySearch compact id="mobile-search-box" /></div>
				<nav class="border-t border-line sm:hidden" aria-label="Earnings Radar">
					<ul class="flex gap-5 overflow-x-auto px-5 text-sm [scrollbar-width:none]">
						{pages.map((l) => (
							<li><a href={l.href} aria-current={l.active ? "page" : undefined}
								class:list={["-mb-px block border-b py-2", l.active ? "border-ink-strong text-ink-strong" : "border-transparent text-muted"]}>{l.label}</a></li>
						))}
					</ul>
				</nav>
			</header>
			<main class="radar mx-auto max-w-[1240px] px-5 pb-24 pt-8 sm:pt-12 lg:px-8">
				<slot name="header" />
				<slot />
			</main>
			<footer class="border-t border-line">
				<div class="mx-auto grid max-w-[1240px] gap-6 px-5 py-8 text-[13px] text-muted md:grid-cols-[1fr_auto] lg:px-8">
					<p class="max-w-2xl">
						A description of what company press releases say, produced by a decision model. It is not a forecast of
						anything and it is not investment advice. Source text: SEC EDGAR.{" "}
						<a href={link("/method/")} class="link">How it works</a>.
					</p>
					<div class="flex flex-wrap items-start gap-x-5 gap-y-1">
						<a href={`${HUB_URL}/privacy/`} class="hover:text-ink-strong">Privacy</a>
						<a href={REPO_URL} class="hover:text-ink-strong">Source and data</a>
						<a href={AUTHOR_URL} class="hover:text-ink-strong">Built by Alejandro Rodríguez Álvarez</a>
					</div>
				</div>
			</footer>
		</div>
	</div>
	<RadarStyles />
</Layout>

<script>
	const toggle = document.getElementById("search-toggle")!;
	const box = document.getElementById("mobile-search")!;
	toggle.addEventListener("click", () => {
		box.hidden = !box.hidden;
		toggle.setAttribute("aria-expanded", String(!box.hidden));
		if (!box.hidden) box.querySelector("input")?.focus();
	});
	// "/" goes to the search from anywhere on the page.
	document.addEventListener("keydown", (e) => {
		if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
		if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return;
		const input = document.querySelector<HTMLInputElement>("#header-search input");
		if (!input || !input.offsetParent) return;
		e.preventDefault();
		input.focus();
	});
</script>
