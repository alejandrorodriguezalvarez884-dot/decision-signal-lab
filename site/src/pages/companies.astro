---
import Page from "../components/Page.astro";
import GuidanceChip from "../components/GuidanceChip.astro";
import { companyUrl, fmtDate, summary } from "../lib/radar";

const sectors = [...new Set(summary.companies.map((c) => c.sector))].sort();
---

<Page
	title="Companies"
	description="The 99 S&P 100 companies covered by the Earnings Radar, with what each said about guidance in its latest results release."
>
	<Fragment slot="header">
		<h1 class="mt-3 font-serif text-3xl font-semibold text-stone-900">Companies</h1>
		<p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-600">
			The S&P 100 as it stood in December 2020, fixed then so that no company is here because of how it did
			afterwards. Each one links to every results release it has filed since 2021.
		</p>
	</Fragment>

	{
		sectors.map((sector) => (
			<section class="mt-10">
				<h2 class="font-serif text-lg font-semibold text-stone-900">{sector}</h2>
				<div class="mt-3 overflow-x-auto rounded-2xl border border-stone-200 bg-white">
					<table class="w-full text-sm">
						<tbody>
							{summary.companies
								.filter((c) => c.sector === sector)
								.map((c) => (
									<tr class="border-b border-stone-100 last:border-0">
										<td class="w-1/2 px-4 py-2.5">
											<a href={companyUrl(c.ticker)} class="font-medium text-stone-900 hover:text-emerald-700">
												{c.name}
											</a>
											<span class="ml-1.5 text-xs text-stone-400">{c.ticker}</span>
										</td>
										<td class="px-3 py-2.5">
											<GuidanceChip value={c.last_guidance} />
										</td>
										<td class="whitespace-nowrap px-4 py-2.5 text-right text-xs tabular-nums text-stone-500">
											{fmtDate(c.last_date)}
										</td>
									</tr>
								))}
						</tbody>
					</table>
				</div>
			</section>
		))
	}
</Page>
