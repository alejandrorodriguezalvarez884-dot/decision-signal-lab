---
// A company of the dataset: every results release since 2021, as the model read it. The latest
// filing is not here but one click away, in the live analysis.
import Page from "../../components/Page.astro";
import GuidanceChip from "../../components/GuidanceChip.astro";
import TrendChart from "../../components/TrendChart.astro";
import {
	FLAGS,
	GUIDANCE_LABEL,
	THEME_WORD,
	cautionWord,
	fmtDate,
	historyOf,
	link,
	outlookWord,
	pct,
	says,
	slug,
	strengthWord,
	summary,
	type Company,
} from "../../lib/radar";

export function getStaticPaths() {
	return summary.companies.map((company) => ({ params: { ticker: slug(company.ticker) }, props: { company } }));
}

interface Props {
	company: Company;
}
const { company } = Astro.props;
const history = historyOf(company.ticker); // oldest first
const rows = [...history].reverse();
const threshold = summary.meta.theme_threshold;

const count = (test: (r: (typeof history)[number]) => boolean) => history.filter(test).length;
// The yes/no reading the company's releases say most often.
const topFlag = FLAGS.map((f) => ({ ...f, n: count((r) => says(r, f.key)) })).sort((a, b) => b.n - a.n)[0];
const tiles = [
	{ label: "Raised guidance", n: count((r) => r.guidance === "raised") },
	{ label: "Lowered guidance", n: count((r) => r.guidance === "lowered") },
	{ label: "Clearly strong results", n: count((r) => r.results_strength >= 0.875) },
	{ label: `Said most often: ${topFlag.label}`, n: topFlag.n },
];

const series = (key: "results_strength" | "outlook_tone" | "uncertainty") =>
	history.map((r) => ({ label: fmtDate(r.date), year: r.date.slice(0, 4), value: r[key] }));
const charts = [
	{
		key: "results_strength" as const,
		title: "Strength of reported results",
		note: "How the release describes the quarter",
		what: "results",
		format: strengthWord,
		ticks: [
			{ v: 0, label: "weak" },
			{ v: 0.5, label: "mixed" },
			{ v: 1, label: "strong" },
		],
	},
	{
		key: "outlook_tone" as const,
		title: "Outlook",
		note: "How management describes the coming periods",
		what: "outlook",
		format: outlookWord,
		ticks: [
			{ v: 0, label: "negative" },
			{ v: 0.5, label: "neutral" },
			{ v: 1, label: "positive" },
		],
	},
	{
		key: "uncertainty" as const,
		title: "Caution about the future",
		note: "How much uncertainty management voices",
		what: "caution",
		format: cautionWord,
		ticks: [
			{ v: 0, label: "none" },
			{ v: 0.5, label: "some" },
			{ v: 1, label: "a lot" },
		],
	},
];
---

<Page
	title={`${company.name}: results releases since 2021`}
	description={`Every results release of ${company.name} since 2021, read by a decision model: guidance, results, outlook, caution and themes.`}
>
	<Fragment slot="header">
		<p class="text-sm text-muted">
			<a href={link("/trends/")} class="underline hover:text-ink-strong">Market trends</a> · {company.sector}
		</p>
		<h1 class="mt-3  text-3xl font-semibold text-ink-strong sm:text-4xl">
			{company.name} <span class="text-xl font-normal text-faint">{company.ticker}</span>
		</h1>
		<p class="mt-2 text-sm text-muted">
			{company.n} results releases, from {fmtDate(history[0].date)} to {fmtDate(rows[0].date)}.
		</p>
		<div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 sec">
			<a
				href={`${link("/analyze/")}?ticker=${company.ticker}`}
				class="btn btn-primary"
			>
				Analyse the latest results live
			</a>
			<span class="text-sm text-muted">Checks EDGAR for the newest filing and reads it now.</span>
		</div>
	</Fragment>

	<section class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
		{
			tiles.map((t) => (
				<div class="sec">
					<div class="text-sm leading-snug text-muted">{t.label}</div>
					<div class="mt-2 text-3xl font-semibold tabular-nums text-ink-strong">
						{t.n} <span class="text-base font-normal text-faint">of {history.length}</span>
					</div>
					<div class="mt-1 text-xs text-muted">{pct(t.n / history.length)} of its releases</div>
				</div>
			))
		}
	</section>

	<section class="mt-12">
		<h2 class="text-xl font-semibold text-ink-strong">Release by release</h2>
		<div class="chart-grid mt-4 grid gap-4 md:grid-cols-2">
			{
				charts.map((c) => (
					<div class="sec">
						<TrendChart title={c.title} note={c.note} points={series(c.key)} max={1} ticks={c.ticks} format={c.format} what={c.what} height={220} words />
					</div>
				))
			}
		</div>
		<div class="mt-4 overflow-x-auto">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-line text-left text-xs text-muted">
						<th class="px-4 py-3 font-medium">Published</th>
						<th class="px-3 py-3 font-medium">Guidance</th>
						<th class="px-3 py-3 font-medium">Results</th>
						<th class="px-3 py-3 font-medium">Outlook</th>
						<th class="px-3 py-3 font-medium">Also says</th>
						<th class="px-4 py-3 text-right font-medium">Filing</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((r) => {
							const says = [
								r.margin_pressure >= 0.5 && "margin pressure",
								r.demand_weakness >= 0.5 && "weak demand",
								...Object.entries(r.themes)
									.filter(([, p]) => p >= threshold)
									.map(([k]) => THEME_WORD[k] ?? k),
							].filter(Boolean);
							return (
								<tr class="border-b border-line last:border-0">
									<td class="whitespace-nowrap px-4 py-2.5 tabular-nums text-muted">{fmtDate(r.date)}</td>
									<td class="px-3 py-2.5" title={`${GUIDANCE_LABEL[r.guidance]}: ${pct(r.guidance_p[r.guidance])}`}>
										<GuidanceChip value={r.guidance} />
									</td>
									<td class="whitespace-nowrap px-3 py-2.5 text-ink">{strengthWord(r.results_strength)}</td>
									<td class="whitespace-nowrap px-3 py-2.5 text-ink">{outlookWord(r.outlook_tone)}</td>
									<td class="px-3 py-2.5 text-xs text-muted">{says.join(", ")}</td>
									<td class="whitespace-nowrap px-4 py-2.5 text-right">
										<a href={r.url} target="_blank" rel="noreferrer" class="text-xs text-muted underline hover:text-ink-strong">
											SEC
										</a>
									</td>
								</tr>
							);
						})
					}
				</tbody>
			</table>
		</div>
	</section>
</Page>

<style>
	@media (min-width: 768px) {
		.chart-grid > :last-child:nth-child(odd) {
			grid-column: span 2;
		}
	}
</style>
