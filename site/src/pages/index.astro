---
import Page from "../components/Page.astro";
import CompanySearch from "../components/CompanySearch.astro";
import { SERIES, deltaText, lastFull, link, pct, quarterLabel, summary, yearBefore } from "../lib/radar";

const m = summary.meta;
const analyse = (ticker: string) => `${link("/analyze/")}?ticker=${ticker}`;
const examples = [
	{ ticker: "AAPL", name: "Apple" },
	{ ticker: "NVDA", name: "Nvidia" },
	{ ticker: "AMD", name: "AMD" },
	{ ticker: "NFLX", name: "Netflix" },
	{ ticker: "UBER", name: "Uber" },
	{ ticker: "COST", name: "Costco" },
];
const steps = [
	{
		title: "Fetch",
		text: "The company's latest results filing is looked up on SEC EDGAR at that moment, and its press release downloaded.",
	},
	{
		title: "Read",
		text: "Tables and legal boilerplate are removed. Names and dates are masked, so the model judges the text and not the company.",
	},
	{
		title: "Answer",
		text: "A decision model answers the same fixed questions for every company and returns a probability for each answer.",
	},
];
const gets = [
	["A one-line verdict", "What the release says, in a sentence."],
	["Guidance", "Raised, lowered, reaffirmed or new, with the probability of each."],
	["What changed", "The same reading of the previous release, side by side."],
	["What stands out", `Where it sits among the latest releases of ${m.companies} large US companies.`],
	["Topics", "Margin pressure, weakening demand, tariffs, AI, supply chain, restructuring."],
];

const prev = yearBefore(lastFull);
const teaser = ["raised", "strong", "margin_pressure", "tariffs"]
	.map((k) => SERIES.find((s) => s.key === k))
	.filter((s) => s !== undefined);
---

<Page
	title="Analyse a company's latest results"
	description="Type any company that files with the SEC. Its latest results release is fetched from EDGAR and read on the spot by a decision model: guidance, results, outlook, margins, demand and themes, as probabilities."
>
	<section class="mx-auto max-w-3xl pt-4 text-center sm:pt-10">
		<p class="inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-3 py-1 text-xs font-medium text-stone-600">
			<span class="live-dot" aria-hidden="true"></span>Runs live on the latest SEC filing
		</p>
		<h1 class="mt-5 font-serif text-4xl font-semibold leading-tight text-stone-900 sm:text-5xl">
			What did the company just say in its results?
		</h1>
		<p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-stone-600">
			Type any company that reports to the SEC. Its latest results release is fetched from EDGAR and read on the
			spot by a decision model that answers fixed questions with probabilities.
		</p>
		<div class="mx-auto mt-8 max-w-2xl text-left">
			<CompanySearch large autofocus />
		</div>
		<p class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm text-stone-500">
			<span>Try</span>
			{
				examples.map((e) => (
					<a
						href={analyse(e.ticker)}
						class="rounded-full border border-stone-200 bg-white px-3 py-1 text-stone-700 transition-colors hover:border-stone-400 hover:text-stone-900"
					>
						{e.name}
					</a>
				))
			}
		</p>
	</section>

	<section class="mt-16 grid gap-4 sm:mt-20 sm:grid-cols-3">
		{
			steps.map((s, i) => (
				<div class="rounded-2xl border border-stone-200 bg-white p-6">
					<div class="flex h-8 w-8 items-center justify-center rounded-full bg-stone-900 text-sm font-semibold text-white">{i + 1}</div>
					<h2 class="mt-4 font-serif text-xl font-semibold text-stone-900">{s.title}</h2>
					<p class="mt-2 text-sm leading-relaxed text-stone-600">{s.text}</p>
				</div>
			))
		}
	</section>

	<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-6 sm:p-8">
		<h2 class="font-serif text-xl font-semibold text-stone-900">What you get</h2>
		<dl class="mt-5 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				gets.map(([title, text]) => (
					<div class="border-l-2 border-stone-200 pl-4">
						<dt class="text-sm font-semibold text-stone-900">{title}</dt>
						<dd class="mt-1 text-sm leading-relaxed text-stone-600">{text}</dd>
					</div>
				))
			}
			<div class="border-l-2 border-stone-200 pl-4">
				<dt class="text-sm font-semibold text-stone-900">How it was done</dt>
				<dd class="mt-1 text-sm leading-relaxed text-stone-600">
					Every step of the run as it happens, and the questions word for word on the{" "}
					<a href={link("/method/")} class="underline hover:text-stone-900">method page</a>.
				</dd>
			</div>
		</dl>
	</section>

	<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-6 sm:p-8">
		<div class="flex flex-wrap items-end justify-between gap-3">
			<div>
				<h2 class="font-serif text-xl font-semibold text-stone-900">Market trends</h2>
				<p class="mt-1 text-sm text-stone-500">
					The same reading over {m.releases.toLocaleString("en-US")} releases from {m.companies} large companies since 2021.
					Releases published in {quarterLabel(lastFull.quarter)}:
				</p>
			</div>
			<a href={link("/trends/")} class="text-sm font-medium text-stone-900 underline underline-offset-4 hover:text-stone-600">
				See all trends
			</a>
		</div>
		<div class="mt-5 grid grid-cols-2 gap-3 lg:grid-cols-4">
			{
				teaser.map((s) => (
					<a href={link("/trends/")} class="rounded-xl border border-stone-200 p-4 transition-colors hover:border-stone-400">
						<div class="text-xs leading-snug text-stone-500">{s.title}</div>
						<div class="mt-2 text-3xl font-semibold tabular-nums text-stone-900">{pct(s.value(lastFull))}</div>
						{prev && <div class="mt-1 text-xs text-stone-500">{deltaText(s.value(lastFull), s.value(prev), quarterLabel(prev.quarter))}</div>}
					</a>
				))
			}
		</div>
	</section>
</Page>

<style>
	.live-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #2a78d6;
		box-shadow: 0 0 0 0 rgba(42, 120, 214, 0.5);
		animation: live-pulse 1.8s infinite;
	}
	@keyframes live-pulse {
		70% {
			box-shadow: 0 0 0 7px rgba(42, 120, 214, 0);
		}
		100% {
			box-shadow: 0 0 0 0 rgba(42, 120, 214, 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.live-dot {
			animation: none;
		}
	}
</style>
