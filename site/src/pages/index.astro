---
import Page from "../components/Page.astro";
import CompanySearch from "../components/CompanySearch.astro";
import { SERIES, deltaText, lastFull, link, pct, quarterLabel, summary, yearBefore } from "../lib/radar";

const m = summary.meta;
const analyse = (ticker: string) => `${link("/analyze/")}?ticker=${ticker}`;
const examples = [
	{ ticker: "AAPL", name: "Apple" },
	{ ticker: "NVDA", name: "Nvidia" },
	{ ticker: "AMD", name: "AMD" },
	{ ticker: "NFLX", name: "Netflix" },
	{ ticker: "UBER", name: "Uber" },
	{ ticker: "COST", name: "Costco" },
];
const steps = [
	{
		title: "Fetch",
		text: "The company's latest results filing is looked up on SEC EDGAR at that moment, and its press release downloaded.",
	},
	{
		title: "Read",
		text: "Tables and legal boilerplate are removed. Names and dates are masked, so the model judges the text and not the company.",
	},
	{
		title: "Answer",
		text: "A decision model answers the same fixed questions for every company and returns a probability for each answer.",
	},
];
const gets = [
	["A one-line verdict", "What the release says, in a sentence."],
	["Guidance", "Raised, lowered, reaffirmed or new, with the probability of each."],
	["What changed", "The same reading of the previous release, side by side."],
	["What stands out", `Where it sits among the latest releases of ${m.companies} large US companies.`],
	["Topics", "Margin pressure, weakening demand, tariffs, AI, supply chain, restructuring."],
];

const prev = yearBefore(lastFull);
const teaser = ["raised", "strong", "margin_pressure", "tariffs"]
	.map((k) => SERIES.find((s) => s.key === k))
	.filter((s) => s !== undefined);
---

<Page
	title="Analyse a company's latest results"
	description="Type any company that files with the SEC. Its latest results release is fetched from EDGAR and read on the spot by a decision model: guidance, results, outlook, margins, demand and themes, as probabilities."
>
	<section>
		<h1 class="lede">What did the company just say in its results?</h1>
		<p class="mt-5 max-w-2xl text-ink">
			Type any company that reports to the SEC. Its latest results release is fetched from EDGAR and read on the spot
			by a decision model that answers the same fixed questions for every company, with a probability for each answer.
		</p>
		<div class="mt-8 max-w-2xl">
			<CompanySearch large autofocus />
		</div>
		<p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
			<span>Try</span>
			{examples.map((e) => <a href={analyse(e.ticker)} class="link">{e.name}</a>)}
		</p>
	</section>

	<div class="mt-16 grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
		<section class="sec">
			<h2 class="sec-title">What you get</h2>
			<dl class="mt-2 divide-y divide-line">
				{gets.map(([title, text]) => (
					<div class="grid gap-x-6 gap-y-0.5 py-3 sm:grid-cols-[10rem_minmax(0,1fr)]"><dt class="text-ink-strong">{title}</dt><dd class="text-sm text-muted">{text}</dd></div>
				))}
			</dl>
		</section>
		<section class="sec self-start">
			<div class="sec-head"><h2 class="sec-title">How a reading is made</h2><a href={link("/method/")} class="sec-note hover:text-ink-strong">The questions, word for word →</a></div>
			<ol class="divide-y divide-line">
				{steps.map((s, i) => (
					<li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-x-3 py-3"><span class="num text-[13px] text-muted">{i + 1}</span>
						<span><span class="block text-ink-strong">{s.title}</span><span class="block text-sm text-muted">{s.text}</span></span></li>
				))}
			</ol>
		</section>
	</div>

	<section class="sec mt-14">
		<div class="sec-head">
			<h2 class="sec-title">Market trends</h2>
			<a href={link("/trends/")} class="sec-note hover:text-ink-strong">All trends →</a>
		</div>
		<p class="max-w-3xl text-sm text-muted">
			The same reading over {m.releases.toLocaleString("en-US")} releases from {m.companies} large companies since 2021.
			Releases published in {quarterLabel(lastFull.quarter)}:
		</p>
		<div class="mt-6 grid grid-cols-2 gap-x-10 gap-y-8 lg:grid-cols-4">
			{teaser.map((s) => (
				<a href={link("/trends/")} class="group block">
					<div class="text-[13px] text-muted group-hover:text-ink-strong">{s.title}</div>
					<div class="num mt-1 text-[2rem] leading-none text-ink-strong">{pct(s.value(lastFull))}</div>
					{prev && <div class="mt-2 text-[12.5px] text-muted">{deltaText(s.value(lastFull), s.value(prev), quarterLabel(prev.quarter))}</div>}
				</a>
			))}
		</div>
	</section>
</Page>
