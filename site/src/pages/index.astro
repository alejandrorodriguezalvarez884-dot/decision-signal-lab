---
import Page from "../components/Page.astro";
import GuidanceChip from "../components/GuidanceChip.astro";
import { companyUrl, fmtDate, latestOf, link, strengthWord, summary } from "../lib/radar";

const sectors = [...new Set(summary.companies.map((c) => c.sector))].sort();
const recent = summary.latest.slice(0, 6);
---

<Page
	title="Analyse a company's latest results"
	description="Pick one of 99 large US companies and see what its latest results release says about guidance, results, outlook, margins and demand, read by a decision model and set against its previous release and its peers."
>
	<Fragment slot="header">
		<h1 class="mt-3 font-serif text-3xl font-semibold leading-tight text-stone-900 sm:text-4xl">
			What did the company say in its latest results?
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-600">
			Pick a company. A decision model has read its latest results release and answered the same fixed questions
			it answers for every company: did guidance go up or down, how strong are the results, are margins under
			pressure, is demand weakening. You get the answers, what changed since the previous release and how the
			company compares with its peers.
		</p>
		<div class="mt-6 max-w-xl">
			<label for="company-search" class="sr-only">Search a company by name or ticker</label>
			<input
				id="company-search"
				type="search"
				autocomplete="off"
				placeholder="Search by name or ticker, for example Apple or NVDA"
				class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-base text-stone-900 placeholder:text-stone-400 focus:border-stone-500 focus:outline-none focus:ring-2 focus:ring-stone-200"
			/>
			<p id="company-empty" class="mt-3 text-sm text-stone-500" hidden>
				No company matches. The tool covers {summary.meta.companies} companies of the S&P 100, listed below.
			</p>
		</div>
	</Fragment>

	<section id="recent" class="mt-10">
		<h2 class="text-sm font-medium text-stone-500">Latest results published</h2>
		<div class="mt-3 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
			{
				recent.map((r) => (
					<a
						href={companyUrl(r.ticker)}
						class="rounded-xl border border-stone-200 bg-white p-4 transition-colors hover:border-stone-400"
					>
						<div class="flex items-baseline justify-between gap-3">
							<span class="font-medium text-stone-900">{r.name}</span>
							<span class="shrink-0 text-xs tabular-nums text-stone-400">{fmtDate(r.date)}</span>
						</div>
						<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-stone-600">
							<GuidanceChip value={r.guidance} />
							<span>Results: {strengthWord(latestOf(r.ticker).results_strength).toLowerCase()}</span>
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section class="mt-12">
		<h2 class="font-serif text-xl font-semibold text-stone-900">All companies</h2>
		<p class="mt-1 text-sm text-stone-500">
			The S&P 100 as it stood in December 2020. The label is what each one said about guidance in its latest release.
		</p>
		{
			sectors.map((sector) => (
				<div class="company-group mt-6">
					<h3 class="text-sm font-medium text-stone-500">{sector}</h3>
					<div class="mt-2 grid gap-2 sm:grid-cols-2">
						{summary.companies
							.filter((c) => c.sector === sector)
							.map((c) => (
								<a
									href={companyUrl(c.ticker)}
									data-company={`${c.name} ${c.ticker}`.toLowerCase()}
									class="company-item flex items-center justify-between gap-3 rounded-lg border border-stone-200 bg-white px-3.5 py-2.5 text-sm transition-colors hover:border-stone-400"
								>
									<span class="min-w-0 truncate">
										<span class="font-medium text-stone-900">{c.name}</span>
										<span class="ml-1.5 text-xs text-stone-400">{c.ticker}</span>
									</span>
									<GuidanceChip value={c.last_guidance} />
								</a>
							))}
					</div>
				</div>
			))
		}
	</section>

	<section class="mt-14 rounded-2xl border border-stone-200 bg-white p-5 sm:p-6">
		<h2 class="font-serif text-lg font-semibold text-stone-900">Across all companies</h2>
		<p class="mt-1 max-w-2xl text-sm leading-relaxed text-stone-600">
			The same readings added up over {summary.meta.releases.toLocaleString("en-US")} releases since 2021: how many
			companies raise or lower guidance each quarter, margin pressure, tariffs, AI. And the study this tool came
			from, including what did not work.
		</p>
		<p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium">
			<a href={link("/trends/")} class="text-stone-900 underline underline-offset-4 hover:text-emerald-700">Market trends</a>
			<a href={link("/method/")} class="text-stone-900 underline underline-offset-4 hover:text-emerald-700">Method and study</a>
		</p>
	</section>
</Page>

<script>
	// Filter the company list as the visitor types. Enter opens the first match.
	const input = document.getElementById("company-search") as HTMLInputElement;
	const items = [...document.querySelectorAll<HTMLAnchorElement>(".company-item")];
	const groups = [...document.querySelectorAll<HTMLElement>(".company-group")];
	const empty = document.getElementById("company-empty")!;
	const recent = document.getElementById("recent")!;

	function apply() {
		const q = input.value.trim().toLowerCase();
		let shown = 0;
		for (const item of items) {
			const match = !q || item.dataset.company!.includes(q);
			item.hidden = !match;
			if (match) shown += 1;
		}
		for (const g of groups) g.hidden = !g.querySelector(".company-item:not([hidden])");
		empty.hidden = shown > 0;
		recent.hidden = q.length > 0;
	}

	input.addEventListener("input", apply);
	input.addEventListener("keydown", (e) => {
		if (e.key !== "Enter") return;
		const first = items.find((i) => !i.hidden);
		if (first && input.value.trim()) window.location.href = first.href;
	});
	apply();
</script>

<style>
	/* `hidden` must win over the flex and grid display set by the utility classes. */
	[hidden] {
		display: none !important;
	}
</style>
